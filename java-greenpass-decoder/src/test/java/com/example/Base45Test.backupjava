package com.example;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class Base45Test {

    @Test
    public void testBase45DecodeWithValidInput() {
        String input = "BBB";
        byte[] expected = new byte[] { 0x00, 0x00 };
        byte[] result = Base45.decode(input);
        assertArrayEquals(expected, result);
    }

    @Test
    public void testBase45DecodeWithInvalidCharacter() {
        String input = "BBX";
        assertThrows(IllegalArgumentException.class, () -> {
            Base45.decode(input);
        });
    }

    @Test
    public void testBase45DecodeWithShortInput() {
        String input = "BB";
        byte[] expected = new byte[] { 0x01 };
        byte[] result = Base45.decode(input);
        assertArrayEquals(expected, result);
    }

    @Test
    public void testBase45DecodeWithEmptyInput() {
        String input = "";
        byte[] expected = new byte[] {};
        byte[] result = Base45.decode(input);
        assertArrayEquals(expected, result);
    }
}

